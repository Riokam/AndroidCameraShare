<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>AndroidCameraShare</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<ApplicationTitle>CameraShare</ApplicationTitle>
		<ApplicationId>com.androidcamerashare.app</ApplicationId>
		<!-- Явно, чтобы MAUI записал versionName в манифест, а не оставил 1.0. -->
		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<!-- Версия: Directory.Build.props (Version / ApplicationVersion). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<AndroidTargetSdkVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">35</AndroidTargetSdkVersion>
		<!-- Fast Deployment на части телефонов (OnePlus) рвёт ADB таймаутами, VS тогда не запускает приложение. -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="QRCoder" Version="1.6.0" />
		<PackageReference Include="Missionware.LibWebrtcSharp.Android" Version="1.12510310.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AndroidCameraShare.Core\AndroidCameraShare.Core.csproj" />
	</ItemGroup>

</Project>
