<Project>
  <PropertyGroup>
    <!-- SemVer для UI, /health и сборок. Меняйте при выпуске. -->
    <Version>1.2.3</Version>
    <!-- Иначе InformationalVersion пустой, а Settings/health читают атрибут сборки. -->
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Android versionName — то, что видит пользователь. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Android versionCode: только вверх при каждой установке поверх предыдущей. -->
    <ApplicationVersion>15</ApplicationVersion>
    <!-- Без git-хеша в версии, иначе /health и тесты плывут. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
